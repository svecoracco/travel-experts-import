# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Fase 1-scaffold: .env.example moet WEL getrackt worden (kale sleutelnamen,
# geen waarden — zie ../.gitignore voor dezelfde regel op root-niveau; deze
# nested .gitignore (uit de gekopieerde frontend) had geen negatie en zou
# web/.env.example anders alsnog negeren).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
