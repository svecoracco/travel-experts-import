# web/.env.example — sleutelnamen alleen, GEEN waarden.
# Kopieer naar web/.env.local (gitignored) voor lokale ontwikkeling en vul
# lokale/placeholder-waarden in. Nooit met echte secrets committen.

# --- NextAuth (fase 4) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- Publieke site/API-URLs ---
NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_API_URL uit de oude frontend verviel met de Flask-token-exchange
# (zie docs/contracts.md); de nieuwe web-app roept de Python-functions
# uitsluitend server-side aan via FUNCTIONS_BASE_URL + FUNCTIONS_KEY hieronder.

# --- Azure AD (NextAuth-provider, fase 4) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Prisma / database (fase 1 schema, fase 4/5 gebruik) ---
# sqlserver-connection-string; DEFAULT_SCHEMA op de login bepaalt het
# actieve client-schema (bts/clientb) — zie prisma/schema.prisma + de
# schema-selectie-spike in docs/contracts.md.
DATABASE_URL=

# --- Functions-koppelvlak (server-side ONLY — nooit NEXT_PUBLIC_*) ---
# Zie docs/contracts.md §Function-key-conventie. FUNCTIONS_KEY mag nooit in
# de browser-bundle terechtkomen; alleen gebruiken in server components /
# route handlers / server actions.
FUNCTIONS_BASE_URL=
FUNCTIONS_KEY=
